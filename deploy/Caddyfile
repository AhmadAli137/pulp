# Caddy reverse proxy with automatic HTTPS (Let's Encrypt) for the domain in $DOMAIN.
# With DOMAIN=localhost Caddy serves plain HTTP on :80 for local testing.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
