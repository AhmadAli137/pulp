# Caddy reverse proxy with automatic HTTPS (Let's Encrypt) for the hostname in $DOMAIN.
# Works with a real domain or a free <ip>.sslip.io name. With DOMAIN=localhost Caddy serves plain HTTP on :80.
# Websockets (the Gemini Live voice relay at /api/voice/...) are proxied transparently.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
