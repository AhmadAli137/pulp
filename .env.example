# PULP configuration. Copy to .env and fill in what you have.
# Path to the folder holding the Tangerine CSVs (monthly_summary.csv, loans.csv, ...).
# Defaults: ./data, then any ./data-*/data folder found next to this file.
EVERPATH_DATA_DIR=
# Gemini API key (optional). Without it, the AI companion runs in deterministic offline mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Gemini native-audio voice relay (websocket; works locally and on Docker/Vultr, not on Vercel)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_API_VERSION=v1alpha
# Live voice preset (female: Aoede, Kore, Leda, Zephyr; male: Puck, Charon, Fenrir, Orus)
GEMINI_LIVE_VOICE=Aoede
# Vultr Serverless Inference (optional second AI provider; OpenAI-compatible). Key: Vultr Console -> Serverless Inference -> Overview.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# auto (Gemini if keyed, else Vultr if keyed, else offline) | gemini | vultr | offline
AI_PROVIDER=auto
# Legacy placeholder; ElevenLabs is not integrated. Active voice uses Gemini Live; text-only mode is silent.
ELEVENLABS_API_KEY=
# Backend host/port
EVERPATH_HOST=127.0.0.1
EVERPATH_PORT=8000
# Frontend dev server reads this to find the API
VITE_API_BASE=http://127.0.0.1:8000
# Public domain for the hosted deployment (Caddy issues HTTPS for it); leave blank locally.
DOMAIN=
# Which Caddyfile docker compose mounts: deploy/Caddyfile (single host from DOMAIN) or deploy/Caddyfile.askpulp (askpulp.com + redirects)
CADDYFILE=./deploy/Caddyfile
# Extra CORS origins, comma-separated (optional)
PULP_ALLOWED_ORIGINS=
